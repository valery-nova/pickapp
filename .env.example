# PickApp MVP environment. Copy to .env.local and fill only what you need.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# demo = in-memory seeded demo (no external services). supabase = PostgreSQL/Storage.
PICKAPP_DATA_MODE=demo
# demo = cookie demo auth. clerk = Clerk authentication.
PICKAPP_AUTH_MODE=demo
PICKAPP_DEMO_SEED=true

# Supabase (required when PICKAPP_DATA_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (required when PICKAPP_AUTH_MODE=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# n8n
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
PICKAPP_AI_ROUTE=direct

# LLM provider (OpenAI-compatible). PICKAPP_LLM_API_KEY has precedence.
# OpenRouter free vision example: PICKAPP_LLM_API_KEY=sk-or-..., PICKAPP_LLM_BASE_URL=https://openrouter.ai/api/v1, PICKAPP_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
PICKAPP_LLM_PROVIDER=openai
PICKAPP_LLM_MODEL=gpt-4o-mini
PICKAPP_LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PICKAPP_LLM_API_KEY=
